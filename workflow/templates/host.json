{
  "host": "trn21",
  "python": "python",
  "out_root": "out",
  "archive_dir": "/data/trn-archive",
  "disk_floor_gib": 6.5,
  "use_cgroup": true,
  "env": {"NEURON_LOGICAL_NC_CONFIG": "2", "NEURON_COMPILE_CACHE_DIR": "/var/neuron-cache/research"},
