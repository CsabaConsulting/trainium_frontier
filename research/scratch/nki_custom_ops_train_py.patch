+                h = x.shape[2]
+                y = _rope_norm_op(x.reshape(b * t, h, d),
+                                  cos.reshape(-1, d // 2), sin.reshape(-1, d // 2))
+                return y.reshape(b, t, h, d)
             return _RopeNormNKI.apply(x, cos, sin)
