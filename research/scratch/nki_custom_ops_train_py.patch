+            else:
+                per_token = _SoftcapCrossEntropyNKI.apply(z, tgt)
             if loss_reduction == "none":
@@ -955,2 +955,9 @@ def rope_norm(x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Te
                 and cos.shape[1] == t and cos.shape[-1] == d // 2 and x.is_contiguous():
+            if USE_NKI_CUSTOM_OPS and _HAS_NKI_CUSTOM_OPS:
