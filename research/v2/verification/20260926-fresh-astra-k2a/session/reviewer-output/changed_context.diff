+def _build_embedding_scatter_kernel():
+    """K2: coalesce duplicate IDs on device before unique gather/add/scatter.
+
+    BF16 inputs are the existing embedding output-cast's backward values;
+    all gradient sums, read/modify/write state and returned masters are FP32.
+    Two programs own disjoint channel slices, including initialization.
+    Native correctness, compiled autograd and cold cost are pending gates.
+    """
+    global nl, nisa
+    import nki
+    import nki.language as nl
+    import nki.isa as nisa
+
+    @nki.jit
+    def scatter(gradient, ids, vocabulary: int):
+        tokens, channels = gradient.shape
+        if gradient.dtype != nl.bfloat16 or tokens % 128 or vocabulary % 128:
+            raise ValueError('K2 native kernel requires BF16 and 128-row multiples')
+        if channels % 2 or channels > 1024 or vocabulary + 128 >= 2 ** 24:
+            raise ValueError('K2 native shape is outside the reviewed contract')
+        if ids.shape != (tokens,):
+            raise ValueError('K2 IDs must be flattened')
+        width = channels // 2
+        c0 = nl.program_id(0) * width
+        # Nonrepresentative positions map to DISTINCT private dummy rows.
+        # This makes each tile's scatter collision-free, even all-same IDs.
+        out = nl.ndarray((vocabulary + 128, channels), dtype=nl.float32, buffer=nl.shared_hbm)
+        zero = nl.ndarray((128, width), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.memset(dst=zero, value=0.0)
+        for vi in nl.sequential_range(vocabulary // 128 + 1):
+            nisa.dma_copy(dst=out[vi * 128:(vi + 1) * 128, c0:c0 + width], src=zero)
+        later = nl.ndarray((128, 128), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.iota(dst=later, pattern=[[1, 128]], channel_multiplier=-1)
+        nisa.tensor_scalar(dst=later, data=later, op0=nl.greater, operand0=0.0)
+        dummy = nl.ndarray((128, 1), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.iota(dst=dummy, pattern=[[0, 1]], offset=vocabulary, channel_multiplier=1)
+        for ti in nl.sequential_range(tokens // 128):
+            # IDs remain exactly represented in FP32; never round IDs to BF16.
+            rows = nl.ndarray((128, 1), dtype=nl.float32, buffer=nl.sbuf)
+            cols = nl.ndarray((128, 128), dtype=nl.float32, buffer=nl.sbuf)
+            nisa.dma_copy(dst=rows, src=ids.ap(pattern=[[1, 128], [0, 1]], offset=ti * 128))
+            nisa.dma_copy(dst=cols, src=ids.ap(pattern=[[0, 128], [1, 128]], offset=ti * 128))
+            equal = nl.ndarray((128, 128), dtype=nl.bfloat16, buffer=nl.sbuf)
+            nisa.tensor_scalar(dst=equal, data=cols, op0=nl.equal, operand0=rows)
+            following = nl.ndarray((128, 128), dtype=nl.float32, buffer=nl.sbuf)
+            nisa.tensor_tensor(dst=following, data1=equal, data2=later, op=nl.multiply)
+            keep = nl.ndarray((128, 1), dtype=nl.float32, buffer=nl.sbuf)
+            nisa.tensor_reduce(dst=keep, data=following, op=nl.add, axis=(1,))
+            nisa.tensor_scalar(dst=keep, data=keep, op0=nl.equal, operand0=0.0)
+            # Pick the LAST occurrence of each ID within the tile.
+            dead = nl.ndarray((128, 1), dtype=nl.float32, buffer=nl.sbuf)
+            nisa.tensor_scalar(dst=dead, data=keep, op0=nl.subtract, operand0=1.0, reverse0=True)
+            chosen = nl.ndarray((128, 1), dtype=nl.float32, buffer=nl.sbuf)
+            nisa.tensor_tensor(dst=chosen, data1=rows, data2=keep, op=nl.multiply)
+            nisa.tensor_tensor(dst=dead, data1=dead, data2=dummy, op=nl.multiply)
+            unique = nl.ndarray((128, 1), dtype=nl.uint32, buffer=nl.sbuf)
+            nisa.tensor_tensor(dst=unique, data1=chosen, data2=dead, op=nl.add)
+            values = nl.ndarray((128, width), dtype=nl.bfloat16, buffer=nl.sbuf)
+            nisa.dma_copy(dst=values, src=gradient[ti * 128:(ti + 1) * 128, c0:c0 + width])
+            grouped = nl.ndarray((128, width), dtype=nl.float32, buffer=nl.psum)
+            # equal is symmetric: equal.T @ values sums every matching token.
+            nisa.nc_matmul(dst=grouped, stationary=equal, moving=values, accumulate=False)
+            selected = nl.ndarray((128, width), dtype=nl.float32, buffer=nl.sbuf)
+            nisa.tensor_scalar(dst=selected, data=grouped, op0=nl.multiply, operand0=keep)
+            existing = nl.ndarray((128, width), dtype=nl.float32, buffer=nl.sbuf)
+            address = out.ap(pattern=[[channels, 128], [1, width]], offset=c0,
+                             vector_offset=unique, indirect_dim=0)
+            nisa.dma_copy(dst=existing, src=address, dge_mode=nisa.dge_mode.swdge)
+            nisa.tensor_tensor(dst=selected, data1=existing, data2=selected, op=nl.add)
+            nisa.dma_copy(dst=address, src=selected, dge_mode=nisa.dge_mode.swdge)
+        return out
+    return scatter
+
+def _install_embedding_scatter(device):
+    global _embedding_scatter_kernel
+    if device.type == 'neuron':
+        from torch_neuronx import wrap_nki
+        _embedding_scatter_kernel = wrap_nki(_build_embedding_scatter_kernel())
+    elif device.type != 'cpu':
+        raise ValueError('K2 supports the gated native path and CPU reference only')
+
+class _EmbeddingScatter(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, weight, ids, output_dtype):
+        if weight.dtype != torch.float32:
+            raise ValueError('K2 requires FP32 embedding masters')
+        ctx.save_for_backward(ids)
+        ctx.shape = weight.shape
+        # Preserve the existing FP32 gather followed by its compute-dtype cast.
+        return F.embedding(ids, weight).to(output_dtype)
+
+    @staticmethod
+    def backward(ctx, gradient):
+        (ids,) = ctx.saved_tensors
+        vocabulary, channels = ctx.shape
+        flat = gradient.reshape(-1, channels).contiguous()
+        if gradient.device.type == 'cpu':
+            # CPU contract only, not a substitute for the native component gate.
+            result = torch.zeros(ctx.shape, dtype=torch.float32, device=gradient.device)
+            result.index_add_(0, ids.reshape(-1).long(), flat.float())
+        elif gradient.device.type == 'neuron':
+            if _embedding_scatter_kernel is None or flat.dtype != torch.bfloat16:
+                raise RuntimeError('K2 native kernel not installed or upstream not BF16')
+            if flat.shape[0] % 128 or vocabulary % 128 or channels % 2 or channels > 1024:
+                raise ValueError('K2 native shape is unsupported; no silent fallback')
+            result = _embedding_scatter_kernel[2](flat, ids.reshape(-1).contiguous(), vocabulary)[:vocabulary]
+        else:
+            raise ValueError('K2 backward requires CPU or native Neuron')
+        return result, None, None
+
