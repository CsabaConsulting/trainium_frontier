      ],
      "removed": [],
      "added": [
        "    if RECURSIVE_SCHEDULE:",
        "        frac = min(step / 300, 1.0)",
        "        m = (1 - frac) * 0.85 + frac * 0.95",
        "        p = min(1.0, max(0.0, progress))",
        "        if p > 1.0 - 0.95:",
        "            cooldown = (p - (1.0 - 0.95)) / 0.95",
        "            m = 0.95 + cooldown ** 2 * (0.79 - 0.95)",
        "        return m"
      ]
    },
