+# bf16-lm-head (2026-09-22, r3): execute ONLY the LM-head logits matmul with two BF16 operands.
+# Under default flags the residual stream is FP32 by the time it reaches the head (the per-block
+# resid_lambda/x0_lambda are shape-(1,) FP32 parameters, and a dimensioned FP32 operand wins
+# type promotion against the BF16 embedding output), so `self.lm_head(x)` runs F.linear on an
+# FP32 activation against the FP32 master weight (Linear.forward's `weight.to(x.dtype)` is an
+# identity there and the BF16 weight cache is unused). This toggle casts BOTH operands to BF16
+# through differentiable .to() calls on the very tensors the original call uses, runs the matmul
+# in BF16 and upcasts the logits to FP32 immediately, before the vocab slice, so every downstream
+# consumer (softcap, CE, byte-loss weighting, eval BPB accumulation, causality check) sees an
+# FP32 tensor of the same shape/strides/contiguity as before. Master parameters, optimizer state,
+# embedding lookup, initialization and every other layer are untouched. Saved in ARCH_TOGGLE_NAMES
+# so load_for_eval reproduces the same head arithmetic in the standalone scorer.
+USE_BF16_LM_HEAD = True
+_LM_HEAD_DTYPES_LOGGED = False
+
+
+def _log_lm_head_dtypes(h16: torch.Tensor, w16: torch.Tensor, logits: torch.Tensor) -> None:
+    """One-time rank-0 evidence line for USE_BF16_LM_HEAD: dtypes of the two head matmul
+    operands and of the returned logits. Returns immediately while Dynamo is tracing, so the
+    compiled forward's graph is byte-identical with or without this call (no print, no global
+    write, no guard on the flag inside the compiled region); it fires at the first EAGER head
+    call -- the post-training causality check / public eval, or every step under --no-compile."""
+    global _LM_HEAD_DTYPES_LOGGED
+    if torch.compiler.is_compiling() or _LM_HEAD_DTYPES_LOGGED:
+        return
+    _LM_HEAD_DTYPES_LOGGED = True
+    print0(f"bf16_lm_head dtypes: activation={h16.dtype} weight={w16.dtype} logits={logits.dtype}")
 
 
