+def _muon_pre(g, momentum_buffer, mom, one_mom, to_bf16: bool):
+    """Group (a) of _muon_math, moved verbatim: out-of-place momentum/Nesterov statements and
+    the NS-input cast. Returns (new momentum buffer, NS input G)."""
+    momentum_buffer = torch.lerp(momentum_buffer, g, one_mom)
+    g = torch.lerp(g, momentum_buffer, mom)
+    x = g.bfloat16() if to_bf16 else g
+    return momentum_buffer, x
+
+
+def _muon_ns(x, tall: bool, ns_steps: int):
+    """Group (b) of _muon_math, moved verbatim: the NS-input normalization plus both
+    Newton-Schulz loops, on a stacked batch of ANY leading size. `tall` / `ns_steps` are the
+    same Python constants _muon_math specialises on."""
+    x = x / (x.norm(dim=(-2, -1), keepdim=True) * 1.01 + 1e-6)
+    if tall:
+        for a, b, c in POLAR_EXPRESS_COEFFS[:ns_steps]:
+            xtx = x.mT @ x
+            x = a * x + x @ (b * xtx + c * (xtx @ xtx))
+    else:
+        for a, b, c in POLAR_EXPRESS_COEFFS[:ns_steps]:
+            xxt = x @ x.mT
+            x = a * x + (b * xxt + c * (xxt @ xxt)) @ x
+    return x
+
+
+def _muon_post(g, w, momentum_buffer, second, lr, lrwd, red_dim: int, red_dim_size: int,
+               one_beta2, lr_fp32: bool = False):
+    """Group (c) of _muon_math, moved verbatim: shape-dependent second-moment update /
+    normalization, LR + weight-decay scaling and the parameter update, on the reconstructed
+    orthogonalized batch `g`. Returns exactly what _muon_math returns, in the same order."""
+    v_mean = g.float().square().mean(dim=red_dim, keepdim=True)
+    v_norm = (v_mean.sum(dim=(-2, -1), keepdim=True) * red_dim_size).sqrt()
+    second = torch.lerp(second, v_mean, one_beta2)
+    step_size = second.clamp_min(1e-10).rsqrt()
+    scaled = (v_mean * red_dim_size) * step_size.square()
+    v_norm_new = scaled.sum(dim=(-2, -1), keepdim=True).sqrt()
+    g = g * (step_size * (v_norm / v_norm_new.clamp_min(1e-10))).to(g.dtype)
+    mask = (g * w) >= 0
+    w = w - (_muon_lr_g(lr, g, lr_fp32) + lrwd * w * mask)
+    return w, momentum_buffer, second
+
+
+def _muon_owner_compiled(cache: dict, helper, key: tuple, device: torch.device):
+    """Lazily build/cache one compiled owner-compute helper with EXACTLY the treatment
+    _MUON_COMPILED gives _muon_math: torch.compile(backend='neuron', dynamic=False) on a neuron
+    device, the plain function elsewhere. `key` is (tall, ns_steps, red_dim, shape)."""
+    fn = cache.get(key)
+    if fn is None:
+        fn = (torch.compile(helper, backend="neuron", dynamic=False)
+              if device.type == "neuron" else helper)
+        cache[key] = fn
+        print0(f"muon step: OWNER-COMPUTE {helper.__name__} for {key[3]} "
+               f"(tall={key[0]} ns_steps={key[1]} red_dim={key[2]})")
+    return fn
+
