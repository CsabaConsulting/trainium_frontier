+def _mlp_in_cast(t: torch.Tensor) -> torch.Tensor:
+    """The MLP-input norm output, cast to BF16 under USE_BF16_MLP_NORM_OUTPUT.
+
+    Guarded on dtype so that under --bf16-norm-output (norm() already BF16) this is
+    byte-for-byte a no-op, and with the toggle off it returns its input unchanged.
+    """
+    if USE_BF16_MLP_NORM_OUTPUT and t.dtype != torch.bfloat16:
+        return t.to(torch.bfloat16)
+    return t
+
