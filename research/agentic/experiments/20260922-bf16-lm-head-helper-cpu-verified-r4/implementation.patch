+def lm_head_logits(h: torch.Tensor, lm_head: "Linear", enabled: bool) -> torch.Tensor:
+    """The LM-head projection, with BF16 matmul operands when `enabled` (USE_BF16_LM_HEAD).
+
+    Disabled: exactly the original call, `lm_head(h)` (Linear.forward; for the FP32 final-normed
+    activation the default flags produce, that path uses the FP32 master weight, so the head
+    matmul runs with FP32 operands).
+
+    Enabled: both operands are cast to BF16 with ordinary DIFFERENTIABLE .to() casts of the FP32
+    tensors the original call uses -- the activation `h` and the FP32 master `lm_head.weight`,
+    NOT the detached per-step weight cache -- the matmul runs in BF16 in the same layout
+    Linear.forward would have used (F.linear, or x @ w under USE_TRANSPOSED_LINEAR), and the
+    result is restored to FP32 immediately so softcap, cross-entropy, byte-loss weighting, eval
+    BPB accumulation and the causality check all consume FP32 logits through unchanged code.
+    Autograd routes the BF16 grads back through the casts, so `lm_head.weight.grad` and the
+    activation grad stay FP32. No autocast context; no other matmul in the model is affected.
+    """
+    if not enabled:
+        return lm_head(h)
+    h16 = h.to(torch.bfloat16)
+    w16 = lm_head.weight.to(torch.bfloat16)
+    out = h16 @ w16 if lm_head.weight_transposed else F.linear(h16, w16, None)
+    return out.float()
+
