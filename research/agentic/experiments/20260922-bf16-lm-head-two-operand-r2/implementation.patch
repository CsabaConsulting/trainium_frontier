+    operands and of the returned logits. torch.compiler.is_compiling() is checked FIRST so Dynamo
+    constant-folds this call away while tracing (no graph break, no guard on the global, no extra
+    recompile); it fires at the first EAGER head call, which under --compile is the post-training
+    causality check on orig_model -- the same forward code and the same dtypes as training."""
+    global _LM_HEAD_DTYPE_LOGGED
+    if torch.compiler.is_compiling() or _LM_HEAD_DTYPE_LOGGED:
+        return
+    _LM_HEAD_DTYPE_LOGGED = True
+    print0(f"lm_head_dtypes: activation={h16.dtype} weight={w16.dtype} logits={logits.dtype}")
 
 
