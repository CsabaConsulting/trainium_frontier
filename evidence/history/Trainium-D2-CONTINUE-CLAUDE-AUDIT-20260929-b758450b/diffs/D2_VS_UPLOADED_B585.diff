+    squared = (gradient * gradient).to(torch.bfloat16)
+    second = torch.lerp(square_avg, squared, 0.001).to(torch.bfloat16)
+    denom = (second / correction).to(torch.bfloat16).sqrt().to(torch.bfloat16)
